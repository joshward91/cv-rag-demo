{
  "name": "harbour-crm-rag-showcase",
  "version": "1.0.0",
  "private": true,
  "description": "A small CRM with a grounded, evaluated help-desk chatbot.",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js",
    "eval": "node eval/run.js",
    "check:docs": "node scripts/check-docs.mjs",
    "count:tokens": "node eval/count-tokens.mjs",
    "build": "node scripts/build.js",
    "serve": "python3 -m http.server 8080"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "onnxruntime-node": "1.30.0",
    "onnxruntime-web": "1.30.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.3.0",
    "esbuild": "0.28.2",
    "playwright": "1.56.1"
  }
}
